<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer: same exclusions as backup_rules.xml -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="reel_vault_app_prefs.xml" />
        <exclude domain="sharedpref" path="wa_status_prefs.xml" />
        <exclude domain="sharedpref" path="billing_entitlement_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="reel_vault_app_prefs.xml" />
        <exclude domain="sharedpref" path="wa_status_prefs.xml" />
        <exclude domain="sharedpref" path="billing_entitlement_prefs.xml" />
    </device-transfer>
</data-extraction-rules>

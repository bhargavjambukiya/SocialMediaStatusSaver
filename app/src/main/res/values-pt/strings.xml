    <string name="dialog_continue">Continuar</string>
    <string name="dialog_whatsapp_guide_intro">O Reel Vault precisa de permissão para ler a pasta de estados. Ao tocar em Continuar, o Android abre o seletor de pastas — siga os passos abaixo.</string>
    <string name="dialog_whatsapp_step_1_num">1</string>
    <string name="dialog_whatsapp_step_1_title">Abra o seletor de pastas</string>
    <string name="dialog_whatsapp_step_1_body">Toque em Continuar. No ecrã seguinte, use &quot;Mostrar armazenamento interno&quot; ou navegue no telemóvel.</string>
    <string name="dialog_whatsapp_step_2_num">2</string>
    <string name="dialog_whatsapp_step_2_title">Vá a esta pasta</string>
    <string name="dialog_whatsapp_step_2_body">Abra as pastas em ordem até chegar a \".Statuses\" (oculta) e selecione-a.</string>
    <string name="dialog_whatsapp_path_regular">Android › media › com.whatsapp › WhatsApp › Media › .Statuses</string>
    <string name="dialog_whatsapp_tip_title">Não vê \".Statuses\"?</string>
    <string name="dialog_whatsapp_tip_body">O nome começa por ponto — alguns seletores escondem pastas com ponto. Primeiro abra:\nAndroid › media › com.whatsapp › WhatsApp › Media\nDepois poderá escolher \".Statuses\".</string>
    <string name="dialog_whatsapp_business_label">Usa o WhatsApp Business?</string>
    <string name="dialog_whatsapp_path_business">Android › media › com.whatsapp.w4b › WhatsApp Business › Media › .Statuses</string>
    <string name="dialog_whatsapp_footer_note">Pode alterar a pasta depois nas definições do sistema.</string>

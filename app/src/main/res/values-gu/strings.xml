    <string name="dialog_continue">ચાલુ રાખો</string>
    <string name="dialog_whatsapp_guide_intro">Reel Vault ને સ્ટેટસ ફોલ્ડર વાંચવા પરમિશન જોઈએ. ચાલુ રાખો પછી Android ફોલ્ડર પિકર ખોલશે — યોગ્ય ફોલ્ડર પસંદ કરો.</string>
    <string name="dialog_whatsapp_step_1_num">1</string>
    <string name="dialog_whatsapp_step_1_title">ફોલ્ડર પિકર ખોલો</string>
    <string name="dialog_whatsapp_step_1_body">ચાલુ રાખો પર ટૅપ કરો. પછી &quot;આંતરિક સ્ટોરેજ બતાવો&quot; પસંદ કરો.</string>
    <string name="dialog_whatsapp_step_2_num">2</string>
    <string name="dialog_whatsapp_step_2_title">આ ફોલ્ડરે જાવ</string>
    <string name="dialog_whatsapp_step_2_body">ક્રમશઃ ફોલ્ડર ખોલો જેવી રીતે છુપી \".Statuses\" મળે, પછી પસંદ કરો.</string>
    <string name="dialog_whatsapp_path_regular">Android › media › com.whatsapp › WhatsApp › Media › .Statuses</string>
    <string name="dialog_whatsapp_tip_title">શું \".Statuses\" દેખાતું નથી?</string>
    <string name="dialog_whatsapp_tip_body">નામ નાના બિંદુ થી શરૂ — કંઈક પિકર ડૉટ-ફોલ્ડર છુપાવે છે. પહેલા અહીં:\nAndroid › media › com.whatsapp › WhatsApp › Media\nપછી \".Statuses\" પસંદ કરી શકશો.</string>
    <string name="dialog_whatsapp_business_label">WhatsApp Business?</string>
    <string name="dialog_whatsapp_path_business">Android › media › com.whatsapp.w4b › WhatsApp Business › Media › .Statuses</string>
    <string name="dialog_whatsapp_footer_note">સિસ્ટમ સેટિંગ્સમાંથી પછી ફેરફાર પણ કરી શકશો.</string>
    <string name="status_empty_recent_images_last_7_days">છેલ્લા 7 દિવસમાં કોઈ સ્ટેટસ ઇમેજ નથી.\n\nWhatsAppમાં નવા સ્ટેટસ પછી રિફ્રેશ કરો.</string>
    <string name="status_empty_recent_videos_last_7_days">છેલ્લા 7 દિવસમાં કોઈ સ્ટેટસ વિડિયો નથી.\n\nWhatsAppમાં નવા સ્ટેટસ પછી રિફ્રેશ કરો.</string>

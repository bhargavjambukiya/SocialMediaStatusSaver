<resources>
    <!-- MaterialComponents parent required for MaterialCardView, MaterialButton, etc. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/colorBackgroundDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Status / nav bar colors are applied at runtime via androidx.activity.EdgeToEdge
             (see BaseActivity). Avoid android:statusBarColor / navigationBarColor here — deprecated on API 35+. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@drawable/bg</item>
    </style>
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <!-- Outlined fields on dark backgrounds (support form). Corner radius set per layout. -->
    <style name="Widget.Support.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">#0D1524</item>
        <item name="boxStrokeColor">@color/support_til_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/support_til_hint</item>
        <item name="counterTextColor">@color/text_on_dark_secondary</item>
    </style>

</resources>
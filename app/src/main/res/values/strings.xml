    <string name="dialog_whatsapp_folder_title">Allow access to statuses</string>
    <string name="dialog_continue">Continue</string>
    <string name="dialog_whatsapp_guide_intro">Reel Vault needs permission to read your status folder. After you tap Continue, Android will open a folder picker — follow the steps below to select the correct folder.</string>
    <string name="dialog_whatsapp_step_1_num">1</string>
    <string name="dialog_whatsapp_step_1_title">Open the folder picker</string>
    <string name="dialog_whatsapp_step_1_body">Tap Continue. On the next screen, use “Show internal storage” or browse into your phone storage if you see it.</string>
    <string name="dialog_whatsapp_step_2_num">2</string>
    <string name="dialog_whatsapp_step_2_title">Navigate to this folder</string>
    <string name="dialog_whatsapp_step_2_body">Open folders in order until you reach the hidden \".Statuses\" folder and select it.</string>
    <string name="dialog_whatsapp_path_regular">Android › media › com.whatsapp › WhatsApp › Media › .Statuses</string>
    <string name="dialog_whatsapp_tip_title">Don’t see \".Statuses\"?</string>
    <string name="dialog_whatsapp_tip_body">The name starts with a dot — some pickers hide dot-folders until you are inside the right parent folder. First open up to:\nAndroid › media › com.whatsapp › WhatsApp › Media\nThen you should be able to choose \".Statuses\".</string>
    <string name="dialog_whatsapp_business_label">Using WhatsApp Business?</string>
    <string name="dialog_whatsapp_path_business">Android › media › com.whatsapp.w4b › WhatsApp Business › Media › .Statuses</string>
    <string name="dialog_whatsapp_footer_note">You can change this folder later from system settings if needed.</string>

    <string name="status_permission_path_hint">Permission not set properly.\n\nPlease select:\nAndroid &gt; media &gt; com.whatsapp &gt; WhatsApp &gt; Media &gt; .Statuses\n\n.Statuses is a hidden folder.</string>

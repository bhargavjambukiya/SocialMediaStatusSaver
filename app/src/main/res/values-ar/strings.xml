    <string name="dialog_continue">متابعة</string>
    <string name="dialog_whatsapp_guide_intro">يحتاج Reel Vault إذن قراءة مجلد الحالات. بعد الضغط على متابعة، يفتح Android منتقي المجلدات — اتبع الخطوات.</string>
    <string name="dialog_whatsapp_step_1_num">1</string>
    <string name="dialog_whatsapp_step_1_title">افتح منتقي المجلدات</string>
    <string name="dialog_whatsapp_step_1_body">اضغط متابعة. في الشاشة التالية اختر &quot;إظهار التخزين الداخلي&quot; أو تصفح الهاتف.</string>
    <string name="dialog_whatsapp_step_2_num">2</string>
    <string name="dialog_whatsapp_step_2_title">انتقل إلى هذا المجلد</string>
    <string name="dialog_whatsapp_step_2_body">افتح المجلدات بالترتيب حتى تصل إلى \".Statuses\" المخفية وحدّدها.</string>
    <string name="dialog_whatsapp_path_regular">Android › media › com.whatsapp › WhatsApp › Media › .Statuses</string>
    <string name="dialog_whatsapp_tip_title">لا ترى \".Statuses\"؟</string>
    <string name="dialog_whatsapp_tip_body">الاسم يبدأ بنقطة — قد تخفيه بعض المنتقيات. افتح أولاً:\nAndroid › media › com.whatsapp › WhatsApp › Media\nثم اختر \".Statuses\".</string>
    <string name="dialog_whatsapp_business_label">تستخدم واتساب Business؟</string>
    <string name="dialog_whatsapp_path_business">Android › media › com.whatsapp.w4b › WhatsApp Business › Media › .Statuses</string>
    <string name="dialog_whatsapp_footer_note">يمكنك تغيير المجلد لاحقاً من إعدادات النظام.</string>
